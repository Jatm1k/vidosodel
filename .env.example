# Ключи API. Можно оставить пустыми и ввести в приложении: Настройки → Ключи API.
LUMEAN_API_KEY=
FASTGEN_API_KEY=

# Адрес веб-интерфейса. 0.0.0.0 откроет доступ с других компьютеров локальной сети.
HOST=127.0.0.1
PORT=8765

# Папка для базы, медиа и видео (по умолчанию ./data)
# DATA_DIR=D:/vidosodel-data
# Явный путь к ffmpeg, если он установлен нестандартно
# FFMPEG_PATH=C:/ffmpeg/bin/ffmpeg.exe
